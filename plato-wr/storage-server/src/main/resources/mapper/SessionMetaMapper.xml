<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.plato.storage.repository.mapper.SessionMetaMapper">

    <!-- ResultMap for SessionMetaEntity -->
    <resultMap id="BaseResultMap" type="com.plato.storage.repository.entity.SessionMetaEntity">
        <result column="session_id" property="sessionId" jdbcType="BIGINT"/>
        <result column="max_seq_id" property="maxSeq" jdbcType="BIGINT"/>
        <result column="last_msg_time" property="lastMsgTime" jdbcType="BIGINT"/>
        <result column="last_msg_sender_id" property="lastMsgSenderId" jdbcType="BIGINT"/>
        <result column="last_msg_type" property="lastMsgType" jdbcType="INTEGER"/>
        <result column="last_msg_content" property="lastMsgContent" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- Update session snapshot after message -->
    <update id="updateSnapshot">
        UPDATE session_meta 
        SET max_seq_id = #{maxSeq},
            last_msg_time = #{lastMsgTime},
            last_msg_sender_id = #{lastMsgSenderId},
            last_msg_type = #{lastMsgType},
            last_msg_content = #{lastMsgContent},
            update_time = NOW()
        WHERE session_id = #{sessionId}
    </update>

</mapper>

